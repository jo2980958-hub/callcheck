{
  "name": "callcheck",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Paste a PayPal API call. Callcheck says what will break in production, then proves it against the sandbox.",
  "scripts": {
    "test": "npm --prefix backend test",
    "test:sandbox": "npm --prefix backend run test:sandbox",
    "build": "npm --prefix frontend run build",
